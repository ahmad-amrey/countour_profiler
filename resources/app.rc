// Windows resources: application icon (Explorer, taskbar, Alt+Tab) and version info.
IDI_ICON1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Contour Profiler"
      VALUE "ProductName", "Contour Profiler"
      VALUE "FileVersion", "0.3.0"
      VALUE "ProductVersion", "0.3.0"
      VALUE "OriginalFilename", "ContourProfiler.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
